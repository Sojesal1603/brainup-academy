# Dependencias y compilación
node_modules/
.next/
out/

# Copias temporales que generan los scripts (compilan código a JS para poder
# ejecutarlo, como hace el vigilante): no son código del proyecto.
.tmp-*/

# Secretos: las claves de IA y de Moodle viven solo aquí, nunca en el repositorio.
.env
.env.local
# Clave del cifrador local antiguo (antes del Paso 15). Estuvo versionada por
# error: se retiró del índice, pero sigue en el historial de git, así que hay
# que tratar las contraseñas de Moodle guardadas con ella como expuestas.
data/.clave-local

# Datos y registros locales (tu base, tus apuntes, los logs del vigilante)
prisma/dev.db
prisma/dev.db-journal
data/logs/
data/backups/
# Mediciones del banco de evaluación: son de este servidor, no del proyecto.
data/eval-runs/

# Basura del sistema
*.log
.DS_Store
Thumbs.db

