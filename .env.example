# Base de datos de producción (PostgreSQL).
#
# En Netlify: Site configuration → Environment variables → DATABASE_URL.
# En Vercel: Project Settings → Environment Variables → DATABASE_URL.
# Proveedores válidos: Supabase, Neon, Vercel Postgres, Railway, RDS…
#
# SUPABASE: copia la cadena del panel (Project Settings → Database → Connection
# string → URI). La app corre en funciones serverless, así que en runtime usa el
# POOLER (puerto 6543) con `pgbouncer=true&connection_limit=1`; la conexión
# directa (5432) es la que necesita `prisma migrate deploy`. Si la contraseña
# lleva caracteres especiales, van escapados en la URL (@ → %40, # → %23…).
#
# Para `prisma migrate deploy` conviene una conexión DIRECTA (sin pooler).
# Si tu proveedor te da una URL con pooler para la app y otra directa para
# migraciones, usa la directa al desplegar y la pooled en runtime.
# En serverless, añade `connection_limit=1` a la URL con pooler para no agotar
# las conexiones de PostgreSQL con muchas funciones a la vez.
DATABASE_URL="postgresql://usuario:password@host:5432/brainup?sslmode=require"

# Puerta de acceso: usuario y contraseña propios, sin pagar la protección de Netlify.
#
# Si las dos están puestas, TODAS las páginas y APIs (menos /login, /api/auth/*
# y el parte de salud /api/salud) exigen sesión. Si faltan, la app queda abierta
# y lo avisa en la consola del servidor.
#
# En Netlify: Site configuration → Environment variables → AUTH_USER,
# AUTH_PASSWORD (y AUTH_SECRET). Los cambios se aplican al volver a desplegar.
#
# AUTH_SECRET firma la cookie de sesión. Si no se pone, se usa la contraseña:
# cambiarla cierra todas las sesiones abiertas, que es lo deseable.
AUTH_USER="yo"
AUTH_PASSWORD="una-contraseña-larga-y-solo-tuya"
AUTH_SECRET="32-bytes-aleatorios-en-base64url"

# Cuántos días dura la sesión en un dispositivo (30 por defecto).
# AUTH_SESSION_DAYS=30

# Escape SOLO para las comprobaciones locales que hablan con la app por HTTP
# (`npm run verify:*`, el vigilante): con 1 la puerta se abre. No lo uses en el
# despliegue.
# AUTH_DISABLED=0

# Solo instalaciones locales con un Moodle de certificado propio.
# NUNCA lo actives en producción: desactiva la verificación TLS de todo el proceso.
# BRAINUP_INSECURE_TLS=1
