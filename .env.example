# Base de datos de producción (PostgreSQL).
#
# En Netlify: Site configuration → Environment variables → DATABASE_URL.
# En Vercel: Project Settings → Environment Variables → DATABASE_URL.
# Proveedores válidos: Supabase, Neon, Vercel Postgres, Railway, RDS…
#
# SUPABASE: copia la cadena del panel (Project Settings → Database → Connection
# string → URI). La app corre en funciones serverless, así que en runtime usa el
# POOLER (puerto 6543) con `pgbouncer=true&connection_limit=1`; la conexión
# directa (5432) es la que necesita `prisma migrate deploy`. Si la contraseña
# lleva caracteres especiales, van escapados en la URL (@ → %40, # → %23…).
#
# Para `prisma migrate deploy` conviene una conexión DIRECTA (sin pooler).
# Si tu proveedor te da una URL con pooler para la app y otra directa para
# migraciones, usa la directa al desplegar y la pooled en runtime.
# En serverless, añade `connection_limit=1` a la URL con pooler para no agotar
# las conexiones de PostgreSQL con muchas funciones a la vez.
#
# SUPABASE: su pooler usa una CA privada. Para verificar de verdad (Prisma
# ignora `sslmode`), añade `sslmode=verify-full&sslaccept=strict` y apunta
# `sslcert` a la CA pública incluida en `prisma/certs/`. Para `pg_dump`/`psql`
# (libpq), usa `sslrootcert` con esa misma CA.
DATABASE_URL="postgresql://usuario:password@host:5432/brainup?sslmode=require"

# Conexión DIRECTA (sin pooler) para migraciones: `prisma migrate deploy`,
# `prisma db push` y `prisma studio`.
#
# Supabase → Project Settings → Database → Connection string → URI (la de
# "Direct connection" o la de "Session mode", puerto 5432), SIN `pgbouncer=true`.
# El esquema la usa como `directUrl`; si falta, las migraciones fallan con
# «Environment variable not found: DIRECT_URL».
#
# En Netlify, Vercel o Render hay que añadirla también como variable de entorno.
DIRECT_URL="postgresql://usuario:password@host:5432/brainup?sslmode=require"

# Rol de runtime dedicado (`prisma_app`), Paso 15. Es OPCIONAL: si falta, la
# app sigue conectando con DATABASE_URL (el rol dueño de las tablas) y lo avisa
# en la consola. Cuando el rol exista en la base, define esta cadena y reinicia:
#
#   npm run db:deploy                 (prisma migrate deploy, con DIRECT_URL)
#   psql "$DIRECT_URL" -v app_password='...' -f prisma/sql/prisma_app.sql
#
# El rol tiene DML y no DDL, NOBYPASSRLS y `statement_timeout=8s`; la app fija
# `app.user_id` en cada transacción de `db(userId)` para que las políticas RLS
# lo limiten también en el SQL crudo. La URL se normaliza sola al pooler
# (6543, `pgbouncer=true`, `connection_limit=1`), así que pega la cadena con el
# puerto 5432 si el panel solo te da esa.
#
# No definas esta variable antes de que el rol exista: la app no arrancaría por
# falta de credenciales válidas contra el pooler.
# PRISMA_APP_DATABASE_URL="postgresql://prisma_app:password@host:5432/brainup?sslmode=verify-full&sslaccept=strict"

# Puerta de acceso: usuario y contraseña propios, sin pagar la protección de Netlify.
#
# Si las dos están puestas, TODAS las páginas y APIs (menos /login, /api/auth/*
# y el parte de salud /api/salud) exigen sesión. Si faltan, la app queda abierta
# y lo avisa en la consola del servidor.
#
# En Netlify: Site configuration → Environment variables → AUTH_USER,
# AUTH_PASSWORD (y AUTH_SECRET). Los cambios se aplican al volver a desplegar.
#
# AUTH_SECRET firma la cookie de sesión. Si no se pone, se usa la contraseña:
# cambiarla cierra todas las sesiones abiertas, que es lo deseable.
AUTH_USER="yo"
AUTH_PASSWORD="una-contraseña-larga-y-solo-tuya"
AUTH_SECRET="32-bytes-aleatorios-en-base64url"

# Cuántos días dura la sesión en un dispositivo (30 por defecto).
# AUTH_SESSION_DAYS=30

# Escape SOLO para las comprobaciones locales que hablan con la app por HTTP
# (`npm run verify:*`, el vigilante): con 1 la puerta se abre. No lo uses en el
# despliegue.
# AUTH_DISABLED=0

# Supabase Auth: identidad real de cada alumno (`requireUser()` en `src/lib/auth.ts`).
#
# El `sub` del JWT es el `userId` que `db(userId)` inyecta en todas las consultas.
# La URL y la anon key son públicas (viajan al navegador en el login); la
# service_role key NO se usa en esta app y no debe ponerse aquí.
#
# En Supabase: Project Settings → API → Project URL / anon public key.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# --- Claves de IA -----------------------------------------------------------
#
# Cada usuario usa SU PROPIA clave de IA (se pega en Ajustes y se guarda
# cifrada). Estas variables del entorno son la clave DE PLATAFORMA y solo las
# gastan los ids de PLATFORM_AI_USER_IDS; cualquier otro usuario sin clave
# propia recibe HTTP 402 `ai_key_required`. Nunca hay fallback silencioso.
#
# PLATFORM_AI_USER_IDS="uuid-del-owner,uuid-de-confianza"
#
# GEMINI_API_KEY="..."
# GROQ_API_KEY="..."
# OPENROUTER_API_KEY="..."
#
# Clave de cifrado de los secretos guardados: las claves de IA de cada usuario y
# la contraseña de Moodle cuando el alumno pide que se guarde (AES-256-GCM,
# 32 bytes en base64). Genérala TÚ y guárdala solo aquí; no se versiona ni se
# inventa. Sin ella, los secretos nuevos no se guardan y los antiguos no se
# pueden leer (la app lo avisa y pide la contraseña otra vez):
#   openssl rand -base64 32
# Sin SECRETS_KEY_V1 (o con una longitud distinta de 32 bytes) la app arranca
# igual, pero solo fallan las acciones que cifran o descifran, con un error
# claro; no se cae el build ni el resto de la aplicación. En el hosting hay que
# replicar también PLATFORM_AI_USER_IDS y SECRETS_KEY_V1.
# SECRETS_KEY_V1="..."
#
# Modelos: la cadena por defecto vive en `src/lib/ai/models.json` (editable).
# Estas variables la sobrescriben sin tocar código, separadas por comas.
# AI_GEMINI_MODELS="gemini-3.6-flash,gemini-3.5-flash"
# AI_GROQ_MODELS="openai/gpt-oss-120b"
#
# Modelos preview/experimentales: 0 en producción (por defecto). Solo se pone a
# 1 en local para probar modelos que Google todavía no ha declarado estables.
ALLOW_PREVIEW_MODELS=0

# Tope por archivo que sube el alumno. 25 MB por defecto; en local se puede
# subir hasta 512. El navegador lee la versión NEXT_PUBLIC (se inlina en el
# build); el servidor, las dos. Ojo: en serverless el cuerpo de la función
# tiene un tope más bajo; para archivos grandes hace falta subida directa.
# AI_MAX_ATTACHMENT_MB=25
# NEXT_PUBLIC_AI_MAX_ATTACHMENT_MB=25


# Web Push (aviso diario del plan). Genera las claves una vez con:
#   npx web-push generate-vapid-keys
# La pública se manda al navegador; la privada no sale del servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="<clave-publica-vapid>"
VAPID_PRIVATE_KEY="<clave-privada-vapid>"
VAPID_SUBJECT="https://brainup.academy"
# Secreto que usa `npm run push:cron` para llamar a /api/push/send-due.
PUSH_CRON_SECRET="<secreto-largo-aleatorio>"

# Instalaciones locales con un Moodle de certificado propio: apunta a su CA.
# No desactives la verificación TLS global: eso afecta también a PostgreSQL
# y a las APIs de IA.
# NODE_EXTRA_CA_CERTS=/ruta/a/la-ca-del-centro.pem
